# Dockerfile-specific allowlist; root .dockerignore is owned by a separate lane.
**
!LICENSE
!NOTICE
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!.node-version
!apps/
!apps/web/
!apps/web/**
!packages/
!packages/contracts/
!packages/contracts/**
# These exclusions win even inside an allowed source tree.
**/.env*
**/.git
**/.git/**
**/.aws/**
**/.ssh/**
**/.codex/**
**/.agents/**
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/.npmrc
**/.pypirc
**/.netrc
**/.git-credentials
**/.docker/**
**/.vercel/**
**/.local/**
**/.cache/**
**/*.log
**/coverage/**
**/node_modules/**
**/.next/**
**/test-results/**
**/playwright-report/**
**/.venv/**
**/__pycache__/**
**/*.pyc
**/*.tsbuildinfo
**/worktrees/**
