{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/mcp-citation/v1",
  "x-fel-version": "1.0.0",
  "title": "McpCitation",
  "description": "A span-level citation (design contract §7.1). start_char/end_char are Unicode code-point offsets into FEL's canonical text for parser_version; text_hash is sha256 of canonical_text[start_char:end_char] encoded as UTF-8. document_content_hash addresses the raw SEC bytes at source_url. reader_url is optional and is emitted only when a public, scope-preserving reader is deployed; when present it carries span, document_version_id, as_of and corpus_version_id. text is untrusted filing content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "span_id",
    "accession",
    "form",
    "company",
    "document_id",
    "document_version_id",
    "parser_version",
    "section_path",
    "start_char",
    "end_char",
    "offset_unit",
    "text",
    "text_hash",
    "document_content_hash",
    "source_url",
    "filing_date",
    "accepted_at",
    "timestamp_precision",
    "untrusted_source_text"
  ],
  "properties": {
    "span_id": {
      "type": "string",
      "format": "uuid"
    },
    "accession": {
      "type": "string",
      "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
    },
    "form": {
      "type": ["string", "null"]
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "cik", "ticker", "name"],
      "properties": {
        "entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "cik": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "ticker": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_char": {
      "type": "integer",
      "minimum": 0
    },
    "end_char": {
      "type": "integer",
      "minimum": 0
    },
    "offset_unit": {
      "const": "unicode_code_point"
    },
    "text": {
      "type": "string"
    },
    "text_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "document_content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "filing_date": {
      "type": "string",
      "format": "date"
    },
    "accepted_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "timestamp_precision": {
      "type": "string",
      "enum": ["second", "approximate"],
      "description": "second: accepted_at is a verified SEC acceptance instant. approximate: the self-hosted approximate mode was used and nothing is guaranteed (design contract §6.2)."
    },
    "reader_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+\\?(?=(?:[^#]*&)?span=)(?=(?:[^#]*&)?document_version_id=)(?=(?:[^#]*&)?as_of=)(?=(?:[^#]*&)?corpus_version_id=)[^#]*$",
      "description": "Scoped web reader deep link. Omitted while the public reader is guarded (PUBLIC_AUTH_NOT_READY)."
    },
    "untrusted_source_text": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "timestamp_precision": {
            "const": "second"
          }
        }
      },
      "then": {
        "properties": {
          "accepted_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  ]
}
