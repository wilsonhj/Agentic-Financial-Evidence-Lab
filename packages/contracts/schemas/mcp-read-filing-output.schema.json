{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/mcp-read-filing-output/v1",
  "x-fel-version": "1.0.0",
  "title": "McpReadFilingOutput",
  "description": "Output of read_filing: one bounded chunk of canonical text with its spans as Citations, and the section outline on the first page only. Every output carries evidence_context and coverage_note (design contract §7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_context",
    "coverage_note",
    "document",
    "section",
    "chunk",
    "spans",
    "outline",
    "next_cursor"
  ],
  "properties": {
    "evidence_context": {
      "$ref": "https://contracts.fel.dev/schemas/mcp-evidence-context/v1"
    },
    "coverage_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "issuers", "forms", "date_range"],
      "description": "What was searched: issuers, forms and date range under the visibility predicate. An empty result reads 'no matching evidence in the visible indexed corpus', never a claim that a company did not disclose something (design contract §7).",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "issuers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Issuers in scope, as CIKs."
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": ["string", "null"],
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "Earliest visible acceptance instant in scope, or null when nothing is visible."
            },
            "to": {
              "type": ["string", "null"],
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "Latest visible acceptance instant in scope, never after effective_as_of; null when nothing is visible."
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "document_version_id",
        "parser_version",
        "company",
        "accession",
        "form",
        "filing_date",
        "accepted_at",
        "timestamp_precision",
        "source_url",
        "document_content_hash"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "document_version_id": {
          "type": "string",
          "format": "uuid"
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_id", "cik", "ticker", "name"],
          "properties": {
            "entity_id": {
              "type": "string",
              "format": "uuid"
            },
            "cik": {
              "type": "string",
              "pattern": "^[0-9]{10}$"
            },
            "ticker": {
              "type": ["string", "null"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "accession": {
          "type": "string",
          "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
        },
        "form": {
          "type": ["string", "null"]
        },
        "filing_date": {
          "type": "string",
          "format": "date"
        },
        "accepted_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timestamp_precision": {
          "type": "string",
          "enum": ["second", "approximate"],
          "description": "second: accepted_at is a verified SEC acceptance instant. approximate: the self-hosted approximate mode was used and nothing is guaranteed (design contract §6.2)."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "document_content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_id", "heading_path", "start_char", "end_char"],
      "properties": {
        "section_id": {
          "type": "string",
          "format": "uuid"
        },
        "heading_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_char", "end_char", "offset_unit", "text", "untrusted_source_text"],
      "properties": {
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        },
        "offset_unit": {
          "const": "unicode_code_point"
        },
        "text": {
          "type": "string"
        },
        "untrusted_source_text": {
          "const": true
        }
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.fel.dev/schemas/mcp-citation/v1"
      }
    },
    "outline": {
      "description": "Section outline on the first page; null on later pages.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "heading_path", "ord"],
            "properties": {
              "section_id": {
                "type": "string",
                "format": "uuid"
              },
              "heading_path": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ord": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "next_cursor": {
      "type": ["string", "null"],
      "maxLength": 2048,
      "description": "Opaque cursor for the next page, or null on the last page."
    }
  }
}
