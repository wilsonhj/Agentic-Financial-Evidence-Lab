{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/mcp-search-filings-output/v1",
  "x-fel-version": "1.0.0",
  "title": "McpSearchFilingsOutput",
  "description": "Output of search_filings: ranked passages, each with a Citation and its lane contributions. Every output carries evidence_context and coverage_note (design contract §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_context", "coverage_note", "results"],
  "properties": {
    "evidence_context": {
      "$ref": "https://contracts.fel.dev/schemas/mcp-evidence-context/v1",
      "properties": {
        "index_version_id": {
          "type": "string",
          "format": "uuid",
          "description": "The resolved published index used for this search; replay supplies this pin."
        },
        "verifier_version": {
          "const": "deterministic-v1",
          "description": "Fixed v1 context marker for non-verification tools; never the active or latest verifier."
        }
      }
    },
    "coverage_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "issuers", "forms", "date_range"],
      "description": "What was searched: issuers, forms and date range under the visibility predicate. An empty result reads 'no matching evidence in the visible indexed corpus', never a claim that a company did not disclose something (design contract §7).",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "issuers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Issuers in scope, as CIKs."
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": ["string", "null"],
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "Earliest visible public_at in scope, or null when nothing is visible."
            },
            "to": {
              "type": ["string", "null"],
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "Latest visible public_at in scope, never after effective_as_of; null when nothing is visible."
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "kind", "fused_score", "lanes", "citation"],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": ["passage", "table_row", "fact"]
          },
          "fused_score": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lane", "lane_rank", "rrf_contribution"],
              "properties": {
                "lane": {
                  "type": "string",
                  "enum": ["lexical", "facts", "tables"],
                  "x-fel-open-enum": true
                },
                "lane_rank": {
                  "type": "integer",
                  "minimum": 1
                },
                "rrf_contribution": {
                  "type": "string",
                  "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                }
              }
            }
          },
          "citation": {
            "$ref": "https://contracts.fel.dev/schemas/mcp-citation/v1"
          }
        }
      }
    }
  }
}
