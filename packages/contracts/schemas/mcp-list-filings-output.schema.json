{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/mcp-list-filings-output/v1",
  "x-fel-version": "1.0.0",
  "title": "McpListFilingsOutput",
  "description": "Output of list_filings: filing metadata visible at effective_as_of. Every output carries evidence_context and coverage_note (design contract §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_context", "coverage_note", "filings", "next_cursor"],
  "properties": {
    "evidence_context": {
      "$ref": "https://contracts.fel.dev/schemas/mcp-evidence-context/v1"
    },
    "coverage_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "issuers", "forms", "date_range"],
      "description": "What was searched: issuers, forms and date range under the visibility predicate. An empty result reads 'no matching evidence in the visible indexed corpus', never a claim that a company did not disclose something (design contract §7).",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "issuers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Issuers in scope, as CIKs."
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "date_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": ["string", "null"],
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "Earliest visible public_at in scope, or null when nothing is visible."
            },
            "to": {
              "type": ["string", "null"],
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "description": "Latest visible public_at in scope, never after effective_as_of; null when nothing is visible."
            }
          }
        }
      }
    },
    "filings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "accession",
          "form",
          "filing_date",
          "accepted_at",
          "public_at",
          "public_at_basis",
          "timestamp_precision",
          "period_end",
          "document_id",
          "document_version_id",
          "source_url",
          "content_hash",
          "amends"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "accession": {
            "type": "string",
            "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
          },
          "form": {
            "type": ["string", "null"]
          },
          "filing_date": {
            "type": "string",
            "format": "date"
          },
          "accepted_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "public_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
            "description": "Instant the filing became public, the visibility instant (ADR-0034 decision 4, Amendment 1). Strict mode shows a document only when public_at <= effective_as_of."
          },
          "public_at_basis": {
            "type": ["string", "null"],
            "enum": ["acceptance", "next_session_open", null],
            "x-fel-open-enum": false,
            "description": "acceptance: public_at equals accepted_at. next_session_open: the filing date is later than the Eastern date of acceptance, so public_at is 06:00 America/New_York on the filing date, the earliest it could have been public."
          },
          "timestamp_precision": {
            "type": "string",
            "enum": ["second", "approximate"],
            "description": "second: accepted_at and public_at are verified instants. approximate: the self-hosted approximate mode was used and nothing is guaranteed (design contract §6.2)."
          },
          "period_end": {
            "type": ["string", "null"],
            "format": "date"
          },
          "document_id": {
            "type": "string",
            "format": "uuid"
          },
          "document_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "amends": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9]{10}-[0-9]{2}-[0-9]{6}$"
              }
            ],
            "description": "Accession this filing amends, when that filing is also visible; else null."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "timestamp_precision": {
                  "const": "second"
                }
              }
            },
            "then": {
              "properties": {
                "accepted_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "public_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                },
                "public_at_basis": {
                  "enum": ["acceptance", "next_session_open"]
                }
              }
            }
          }
        ]
      }
    },
    "next_cursor": {
      "type": ["string", "null"],
      "maxLength": 2048,
      "description": "Opaque cursor for the next page, or null on the last page."
    }
  }
}
