{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/mcp-evidence-context/v1",
  "x-fel-version": "1.0.0",
  "title": "McpEvidenceContext",
  "description": "The resolved point-in-time context of one MCP response (design contract §6.3): cutoff, timestamp mode, corpus/index/parser/verifier pins, the selected document version where one applies, and a cursor's frozen filters. Optional members are required-and-nullable so the shape is stable for byte-identical replay. A client keeps one context per research workflow by passing effective_as_of and the pins back as request inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effective_as_of",
    "timestamp_mode",
    "temporal_guarantee",
    "corpus_version_id",
    "index_version_id",
    "parser_version",
    "verifier_version",
    "document_version_id",
    "filters"
  ],
  "properties": {
    "effective_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "The cutoff instant actually used."
    },
    "timestamp_mode": {
      "type": "string",
      "enum": ["strict", "approximate"]
    },
    "temporal_guarantee": {
      "type": "string",
      "enum": ["strict", "none"],
      "description": "strict under timestamp_mode strict; none under approximate, whose results are excluded from temporal acceptance evidence."
    },
    "corpus_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "index_version_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Resolved retrieval index pin; null only when no published index exists for the corpus pin."
    },
    "parser_version": {
      "type": ["string", "null"],
      "description": "Parser version of the selected document version; null when the response spans several document versions (each Citation carries its own)."
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "document_version_id": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "The selected document version where one applies, else null."
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Filters frozen into this context's cursors. A cursor used with different filters returns invalid_input.",
      "properties": {
        "company": {
          "type": "string"
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concept": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "format": "uuid"
        },
        "section": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "timestamp_mode": {
            "const": "strict"
          }
        }
      },
      "then": {
        "properties": {
          "temporal_guarantee": {
            "const": "strict"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timestamp_mode": {
            "const": "approximate"
          }
        }
      },
      "then": {
        "properties": {
          "temporal_guarantee": {
            "const": "none"
          }
        }
      }
    }
  ]
}
