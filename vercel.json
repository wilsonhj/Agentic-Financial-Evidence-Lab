{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "FEL_API_SERVICE_URL"
        }
      ]
    },
    "api": {
      "root": "./",
      "runtime": "container",
      "entrypoint": "infra/docker/api.Dockerfile",
      "routes": [
        {
          "src": "/__fel_api/health",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/health" }]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/__fel_api/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
